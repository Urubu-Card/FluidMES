datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Empresa {
  id                 Int       @id @default(autoincrement())
  nome_empresa       String
  cnpj               String    @unique
  nome_representante String
  email              String    @unique
  cpf                String    @unique
  senha              String
  nivel_acesso       String    @default("admin") // Sempre admin
  criado_em          DateTime  @default(now())
  
  // Relacionamentos
  funcionarios       Funcionario[]
  tarefas_criadas    Task[]        @relation("EmpresaCriador")
  tarefas_aprovadas  Task[]        @relation("EmpresaAprovador")

  @@map("empresas")
}

model Funcionario {
  id           Int      @id @default(autoincrement())
  empresa_id   Int
  nome         String
  cpf          String   @unique
  email        String   @unique
  senha        String
  cargo        String
  nivel_acesso String   // Deverá ser preenchido como: "comprador_master" ou "comprador_junior"
  criado_em    DateTime @default(now())

  // Relacionamentos
  empresa            Empresa  @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  tarefas_criadas    Task[]   @relation("FuncionarioCriador")
  tarefas_aprovadas  Task[]   @relation("FuncionarioAprovador")

  @@map("funcionarios")
}

model Task {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String?
  situacao     String   // "Pendente", "Em andamento", "Parado", "Concluido", "Cancelado"
  criada_em    DateTime @default(now())

  // IDs dos criadores (opcionais, pois apenas um criará a tarefa)
  empresa_criador_id     Int?
  funcionario_criador_id Int?

  // IDs dos aprovadores (opcionais, preenchidos após a aprovação)
  aprovado_por_empresa_id     Int?
  aprovado_por_funcionario_id Int?

  // Mapeamento dos relacionamentos no Prisma
  empresa_criador         Empresa?     @relation("EmpresaCriador", fields: [empresa_criador_id], references: [id], onDelete: SetNull)
  funcionario_criador     Funcionario? @relation("FuncionarioCriador", fields: [funcionario_criador_id], references: [id], onDelete: SetNull)
  aprovado_por_empresa    Empresa?     @relation("EmpresaAprovador", fields: [aprovado_por_empresa_id], references: [id], onDelete: SetNull)
  aprovado_por_funcionario Funcionario? @relation("FuncionarioAprovador", fields: [aprovado_por_funcionario_id], references: [id], onDelete: SetNull)

  @@map("tasks")
}
